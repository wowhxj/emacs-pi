;;; live-model-child.el --- Disposable two-call live Pi client -*- lexical-binding: t; -*-
(require 'emacs-pi)
(defun pi-live-wait (predicate &optional seconds)
  (let ((end (+ (float-time) (or seconds 90))))
    (while (and (not (funcall predicate)) (< (float-time) end)) (accept-process-output nil .03))
    (unless (funcall predicate) (error "Live probe deadline exceeded"))))
(let* ((root (getenv "PI_LIVE_ROOT")) (mode (getenv "PI_LIVE_MODE"))
       (emacs-pi-persistent t) (emacs-pi-runtime-directory (expand-file-name "runtime" root))
       (emacs-pi-executable (getenv "PI_LIVE_EXECUTABLE"))
       (emacs-pi-extra-arguments
        (list "--offline" "--no-mcp" "--no-extensions" "--no-skills" "--no-prompt-templates"
              "--tools" "bash" "--thinking" "off" "--provider" "lifecycle-live" "--model" "deepseek-chat"
              "--system-prompt" "Isolated lifecycle test. Follow only the exact test task."
              "-e" (getenv "PI_LIVE_EXTENSION")))
       buffer failure question)
  (cl-letf (((symbol-function 'emacs-pi--extension)
             (lambda (_session request)
               (when (equal (emacs-pi--jget request "method") "confirm")
                 (unless (equal (emacs-pi--jget request "title") "LIVE-PROBE-ONLY")
                   (error "Unexpected confirmation; no reply sent"))
                 (setq question request)))))
    (emacs-pi-open-session (expand-file-name "history.jsonl" root)
                          :directory (expand-file-name "work" root) :display 'none
                          :on-ready (lambda (value) (setq buffer value))
                          :on-error (lambda (value) (setq failure value)))
    (pi-live-wait (lambda () (or buffer failure)) 35)
    (when failure (error "Live restore failed: %s" failure))
    (unless (file-exists-p (expand-file-name "extension-loaded" root)) (error "Approval guard did not load; no prompt sent"))
    (let* ((session (buffer-local-value 'emacs-pi--session buffer))
           (connection (emacs-pi-session-connection session))
           (generation (emacs-pi--jget (emacs-pi-session-runtime-state session) "generation")))
      (if (equal mode "start")
          (progn
            (emacs-pi-rpc-request
             connection "prompt"
             (emacs-pi--jobject "message" (getenv "PI_LIVE_PROMPT"))
             (lambda (result) (unless (plist-get result :ok) (setq failure "Prompt rejected"))) 100)
            (pi-live-wait (lambda () (or question failure)))
            (when failure (error "%s" failure))
            (emacs-pi-rpc-request connection "prompt"
                                  (emacs-pi--jobject "message" "STEER_LIVE_PROBE: after the authorized marker command, reply exactly OK."
                                                    "streamingBehavior" "steer")
                                  (lambda (result) (unless (plist-get result :ok) (setq failure "Steering rejected"))) 100)
            (pi-live-wait (lambda () (or failure (string-match-p "STEER_LIVE_PROBE" (prin1-to-string (emacs-pi-session-steering session))))) 15)
            (when failure (error "%s" failure))
            (with-temp-file (expand-file-name "armed.json" root)
              (insert (json-serialize `((generation . ,generation) (questionId . ,(emacs-pi--jget question "id")) (queued . t)))))
            (while t (accept-process-output nil .1)))
        (let* ((armed (with-temp-buffer (insert-file-contents (expand-file-name "armed.json" root))
                                       (json-parse-buffer :object-type 'alist)))
               (marker (expand-file-name "work/marker" root)))
          (unless (equal generation (alist-get 'generation armed)) (error "Live owner generation changed"))
          (pi-live-wait (lambda () question) 15)
          (unless (and (equal (emacs-pi--jget question "id") (alist-get 'questionId armed))
                       (string-match-p "STEER_LIVE_PROBE" (prin1-to-string (emacs-pi-session-steering session)))
                       (not (file-exists-p marker)))
            (error "Approval/steering recovery mismatch; no reply sent"))
          ;; Only this explicitly test-owned prompt is approved, after exact checks.
          (emacs-pi-rpc-reply connection (emacs-pi--jobject "type" "extension_ui_response" "id" (emacs-pi--jget question "id") "confirmed" t))
          (pi-live-wait (lambda () (and (file-exists-p marker) (not (emacs-pi-session-running session)))) 90)
          (let (state)
            (emacs-pi-rpc-request connection "get_state" nil (lambda (r) (setq state r)))
            (pi-live-wait (lambda () state) 15)
            (unless (plist-get state :ok) (error "Final state unavailable")))
          (with-temp-file (expand-file-name "verified.json" root)
            (insert (json-serialize `((generation . ,generation) (questionRestored . t) (steeringRestored . t)
                                     (steeringDrained . ,(if (emacs-pi-session-steering session) :false t))))))
          (with-current-buffer buffer (emacs-pi-quit))
          (pi-live-wait (lambda () (not (buffer-live-p buffer))) 15))))))
